{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WireObservation",
  "definitions": {
    "WireObservation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1"
        },
        "session_id": {
          "type": "string"
        },
        "step": {
          "type": "number"
        },
        "task": {
          "type": "string"
        },
        "page": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "viewport": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              },
              "required": [
                "w",
                "h"
              ],
              "additionalProperties": false
            },
            "scroll": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "url",
            "title",
            "viewport",
            "scroll"
          ],
          "additionalProperties": false
        },
        "dom": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SanitizedNode"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "number"
              },
              "thought": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Action"
                }
              },
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ActionResult"
                }
              }
            },
            "required": [
              "step",
              "thought",
              "actions",
              "results"
            ],
            "additionalProperties": false
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WireImage"
          }
        }
      },
      "required": [
        "dom",
        "history",
        "images",
        "page",
        "schema_version",
        "session_id",
        "step",
        "task"
      ],
      "additionalProperties": false
    },
    "SanitizedNode": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "element",
            "text"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/definitions/BBox"
        },
        "visible": {
          "type": "boolean"
        },
        "in_viewport": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/definitions/NodeState"
        },
        "scroll_parent": {
          "type": "string"
        },
        "attrs": {
          "$ref": "#/definitions/SkeletonAttrs"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemanticFlag"
          }
        },
        "secret": {
          "type": "boolean"
        },
        "marker": {
          "$ref": "#/definitions/ExclusionMarker"
        },
        "image": {
          "$ref": "#/definitions/ImageKind"
        },
        "image_omitted": {
          "$ref": "#/definitions/ImageOmittedReason"
        },
        "form_action_origin": {
          "type": "string"
        },
        "context_hints": {
          "$ref": "#/definitions/ContextHints"
        },
        "content": {
          "type": "object",
          "properties": {
            "accessible_name": {
              "type": "string"
            },
            "href": {
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "placeholder": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "bbox",
        "content",
        "in_viewport",
        "node_id",
        "node_type",
        "parent_id",
        "tag",
        "visible"
      ],
      "additionalProperties": false
    },
    "BBox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "NodeState": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "checked": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "expanded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SkeletonAttrs": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SemanticFlag": {
      "type": "string",
      "enum": [
        "error",
        "disabled",
        "active",
        "hidden"
      ]
    },
    "ExclusionMarker": {
      "type": "string",
      "enum": [
        "iframe_skipped",
        "shadow_closed_skipped",
        "canvas_skipped",
        "svg_skipped",
        "video_skipped"
      ]
    },
    "ImageKind": {
      "type": "string",
      "enum": [
        "img",
        "background"
      ]
    },
    "ImageOmittedReason": {
      "type": "string",
      "enum": [
        "too_small",
        "unreadable",
        "detector_failed",
        "request_limit"
      ]
    },
    "ContextHints": {
      "type": "object",
      "properties": {
        "in_landmark": {
          "type": "boolean"
        },
        "near_contact_heading": {
          "type": "boolean"
        },
        "in_contact_markup": {
          "type": "boolean"
        },
        "in_ugc_block": {
          "type": "boolean"
        }
      },
      "required": [
        "in_landmark",
        "near_contact_heading",
        "in_contact_markup",
        "in_ugc_block"
      ],
      "additionalProperties": false
    },
    "Action": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "click"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "type"
            },
            "node_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "submit": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "node_id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "node_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scroll"
            },
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          },
          "required": [
            "type",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scroll_to"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "navigate"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wait"
            },
            "ms": {
              "type": "number",
              "maximum": 3000
            }
          },
          "required": [
            "type",
            "ms"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ActionResult": {
      "type": "string",
      "enum": [
        "ok",
        "stale_node",
        "not_interactable",
        "blocked",
        "not_run"
      ]
    },
    "WireImage": {
      "type": "object",
      "properties": {
        "img_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "mime": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "data",
        "img_id",
        "mime",
        "node_id"
      ],
      "additionalProperties": false
    }
  }
}
