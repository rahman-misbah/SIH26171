{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WireAgentResponse",
  "definitions": {
    "WireAgentResponse": {
      "$ref": "#/definitions/AgentResponse"
    },
    "AgentResponse": {
      "type": "object",
      "properties": {
        "thought": {
          "type": "string",
          "maxLength": 200
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Action"
          },
          "maxItems": 3
        },
        "done": {
          "type": "boolean"
        },
        "answer": {
          "type": "string"
        }
      },
      "required": [
        "thought",
        "actions",
        "done"
      ],
      "additionalProperties": false
    },
    "Action": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "click"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "type"
            },
            "node_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "submit": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "node_id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "node_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scroll"
            },
            "direction": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          },
          "required": [
            "type",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scroll_to"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "navigate"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wait"
            },
            "ms": {
              "type": "number",
              "maximum": 3000
            }
          },
          "required": [
            "type",
            "ms"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
